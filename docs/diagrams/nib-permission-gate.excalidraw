    },
    {
      "type": "text",
      "id": "d_n2",
      "x": 640,
      "y": 1904,
      "width": 330,
      "height": 50,
      "text": "Every block counts, rules or judge.\nA user approval clears the streak,\nnot the 20-block total.",
      "originalText": "Every block counts, rules or judge.\nA user approval clears the streak,\nnot the 20-block total.",
      "fontSize": 12,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#64748b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
