    {
      "type": "text",
      "id": "d_n1",
      "x": 640,
      "y": 1804,
      "width": 330,
      "height": 50,
      "text": "credential or protected path, git config op,\nunsandboxed run, or your own ask rule.\nHandoff: a real prompt, no write-set overlay.",
      "originalText": "credential or protected path, git config op,\nunsandboxed run, or your own ask rule.\nHandoff: a real prompt, no write-set overlay.",
      "fontSize": 12,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#64748b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
