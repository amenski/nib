    {
      "type": "text",
      "id": "d_ev_t",
      "x": 1016,
      "y": 1796,
      "width": 830,
      "height": 130,
      "text": "// what the judge reads, identical in both stages (one cacheable prefix)\nsystem   trust environment, BLOCK groups, rule tags, ALLOW exceptions\nturns    human messages only, last 10: [\"build the docs\", \"don't push\"]\nprior    earlier calls, tool + args only, last 30:\n         [{ \"tool\": \"run_bash\", \"args\": \"{\\\"command\\\":\\\"npm i\\\"}\" }]\npending  { \"tool\": \"run_bash\", \"arguments\": { ... } }   // DATA, not instructions\nrules    { \"kind\": \"shell\", \"parse\": \"ok\", \"segments\": [ ... ] }\nnever    tool results, assistant prose",
      "originalText": "// what the judge reads, identical in both stages (one cacheable prefix)\nsystem   trust environment, BLOCK groups, rule tags, ALLOW exceptions\nturns    human messages only, last 10: [\"build the docs\", \"don't push\"]\nprior    earlier calls, tool + args only, last 30:\n         [{ \"tool\": \"run_bash\", \"args\": \"{\\\"command\\\":\\\"npm i\\\"}\" }]\npending  { \"tool\": \"run_bash\", \"arguments\": { ... } }   // DATA, not instructions\nrules    { \"kind\": \"shell\", \"parse\": \"ok\", \"segments\": [ ... ] }\nnever    tool results, assistant prose",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#e2e8f0",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100,
