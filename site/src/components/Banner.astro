---
import { strings, BANNER_CMD, CHANGELOG_URL } from '../lib/strings';
import type { Lang } from '../lib/i18n';

interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props;
const t = strings[lang];
---
<div class="banner">
  <span>{t.banner}</span>
  <code>{BANNER_CMD}</code>
  <a href={CHANGELOG_URL}>{t.nav.changelog} →</a>
</div>

<style>
.banner{display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:4px 12px;padding:8px 24px;font-size:13px;text-align:center;background:color-mix(in srgb,var(--accent) 14%,var(--bg));border-bottom:1px solid color-mix(in srgb,var(--accent) 30%,var(--line))}
code{font-size:12.5px;color:var(--accent)}
a{color:var(--accent);font-weight:600;text-decoration:none;white-space:nowrap}
a:hover{text-decoration:underline}
</style>
