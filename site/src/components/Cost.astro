---
import { strings } from '../lib/strings';
import type { Lang } from '../lib/i18n';

interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props;
const t = strings[lang].cost;
const [total, ...rest] = t.stats;
const fig = strings[lang].fig;
---
<section id="cost" class="reveal">
  <h2>{t.h2}</h2>
  <p class="sub">{t.sub}</p>
  <div class="stats">
    <div class="total"><div class="n">{total.n}</div><p>{total.p}</p></div>
    <div class="rest">
      {rest.map((s) => <div><div class="n small">{s.n}</div><p>{s.p}</p></div>)}
    </div>
  </div>
  <figure>
    <img class="frame" src="/usage-deepseek-flash.png" width="1458" height="200" alt={t.usageAlt} loading="lazy">
    <figcaption><span class="mono">{fig} 02</span>{t.caption}</figcaption>
  </figure>
</section>

<style>
.stats{display:flex;justify-content:space-between;align-items:flex-end;gap:40px 64px;flex-wrap:wrap}
.n{font-family:var(--mono);font-weight:500;font-size:clamp(64px,10vw,128px);letter-spacing:-.06em;line-height:.95;color:var(--accent)}
.n.small{font-size:clamp(32px,4vw,48px);letter-spacing:-.04em;color:var(--text)}
.total p,.rest p{margin:12px 0 0;color:var(--muted);font-size:15px;max-width:30ch}
.rest{display:flex;gap:48px;flex-wrap:wrap}
figure{margin:56px 0 0}
</style>
