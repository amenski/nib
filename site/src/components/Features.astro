---
import { strings } from '../lib/strings';
import type { Lang } from '../lib/i18n';
import Demo from './Demo.astro';
import undo from '../demos/undo.txt?raw';

interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props;
const t = strings[lang].features;
// Text between backticks is inline code.
const parts = (s: string) => s.split('`');
---
<section id="features" class="reveal">
  <h2>{t.h2}</h2>
  <div class="bento">
    {t.items.map((f) => (
      <div class={`cell ${f.size}`}>
        <div>
          <h3>{f.title}</h3>
          <p>{parts(f.body).map((s, i) => (i % 2 ? <code>{s}</code> : s))}</p>
        </div>
        {f.size === 'e' && <pre>nib -p "fix the failing test"</pre>}
      </div>
    ))}
  </div>
  <Demo text={undo} ranges={[[23, 31], [58, 58], [61, 61]]} n="06" caption={t.demo} {lang} />
</section>

<style>
.bento{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:16px;margin-top:40px}
.cell{border:1px solid var(--line);border-radius:var(--radius);padding:28px;background:var(--bg-2);transition:border-color .25s}
.cell:hover{border-color:var(--line-2)}
.a{grid-column:span 4;background:linear-gradient(150deg,color-mix(in srgb,var(--accent) 22%,transparent),transparent 62%),var(--bg-2)}
.b{grid-column:span 2;background:radial-gradient(var(--line-2) 1px,transparent 1px) 0 0/14px 14px,var(--bg-2)}
.c,.d{grid-column:span 3}
.e{grid-column:span 6;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:32px;align-items:center}
h3{margin:0 0 10px;font-size:20px;letter-spacing:-.02em}
p{margin:0;color:var(--muted);font-size:16px;max-width:52ch}
code{font-size:14px;color:var(--accent)}
@media(max-width:860px){.bento{grid-template-columns:1fr}.a,.b,.c,.d,.e{grid-column:auto}.e{grid-template-columns:1fr;gap:20px}}
</style>
