---
import { strings, REPO_URL } from '../lib/strings';
import { homeAnchor, type Lang } from '../lib/i18n';

interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props;
const t = strings[lang].hero;
---
<section class="hero">
  <h1 class="hero-in" style="--i:0">{t.h1}</h1>
  <div class="grid">
    <div class="copy">
      <p class="lead hero-in" style="--i:1">{t.lead}</p>
      <div class="cta hero-in" style="--i:2">
        <a class="btn btn-primary" href={homeAnchor(lang, 'install')}>{t.install}</a>
        <a class="btn btn-ghost" href={REPO_URL}>{t.source}</a>
      </div>
    </div>
    <div class="media hero-in" style="--i:3">
      <video controls preload="none" playsinline poster="/nib-launch.jpg" width="1920" height="1080" aria-label={t.video}>
        <source src="/nib-launch.mp4" type="video/mp4">
      </video>
    </div>
  </div>
</section>

<style>
.grid{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:clamp(32px,5vw,64px);align-items:center;margin-top:48px}
.lead{font-size:clamp(18px,1.6vw,21px);line-height:1.5;color:var(--muted);max-width:36ch;margin:0 0 32px}
.cta{display:flex;gap:12px;flex-wrap:wrap}
.media{border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;background:var(--code);box-shadow:0 40px 90px -40px color-mix(in srgb,var(--accent) 45%,transparent)}
video{display:block;width:100%;height:auto;aspect-ratio:16/9}
@media(max-width:860px){.grid{grid-template-columns:1fr;margin-top:32px}.media{order:-1}}
</style>
