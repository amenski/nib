---
import { strings } from '../lib/strings';
import type { Lang } from '../lib/i18n';

interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props;
const t = strings[lang].how;
const alt = strings[lang].hero.alt;
const [install, auth, run] = t.comments;
const commands = ['npm install -g @amenski/nib', 'nib auth', 'nib'];
---
<section id="install" class="reveal">
  <h2>{t.h2}</h2>
  <p class="sub">{t.sub}</p>
  <div class="term">
    <button class="copy mono" type="button" data-copy={commands.join('\n')} data-done={t.copied} aria-live="polite">{t.copy}</button>
<pre><span class="c"># {install}</span>
{commands[0]}

<span class="c"># {auth}</span>
{commands[1]}

<span class="c"># {run}</span>
{commands[2]}</pre>
  </div>
  <p class="brew">{t.brew} <code>brew install amenski/tap/nib</code></p>
  <img class="frame shot" src="/prompt-screen.png" width="2864" height="674" alt={alt} loading="lazy">
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(btn.dataset.copy ?? ''); } catch { return; }
      const label = btn.textContent;
      btn.textContent = btn.dataset.done ?? label;
      setTimeout(() => { btn.textContent = label; }, 1600);
    });
  });
</script>

<style>
.term{position:relative}
.copy{position:absolute;top:12px;right:12px;padding:6px 12px;border:1px solid var(--line-2);border-radius:var(--radius);background:var(--bg-3);color:var(--muted);cursor:pointer;transition:color .2s,border-color .2s}
.copy:hover{color:var(--text);border-color:var(--muted)}
.brew{margin:16px 0 40px;color:var(--muted);font-size:15px}
.brew code{color:var(--text)}
.shot{margin-top:0}
</style>
