---
import { strings } from '../lib/strings';
import type { Lang } from '../lib/i18n';

interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props;
const t = strings[lang].install;
---
<section id="install">
  <h2>{t.h2}</h2>
  <p class="sub">{t.sub}</p>
  <div class="install">
    <pre>npm install -g @amenski/nib</pre>
    <pre>brew install amenski/tap/nib</pre>
  </div>
</section>

<style>
.install{display:grid;grid-template-columns:1fr 1fr;gap:16px}
@media(max-width:860px){.install{grid-template-columns:1fr}}
</style>
