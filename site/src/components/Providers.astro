---
import { strings, PROVIDERS } from '../lib/strings';
import type { Lang } from '../lib/i18n';

interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props;
const t = strings[lang].providers;
---
<section id="providers" class="reveal">
  <h2>{t.h2}</h2>
  <p class="sub">{t.sub.split('`').map((s, i) => (i % 2 ? <code>{s}</code> : s))}</p>
  <div class="providers">
    {PROVIDERS.map((p) => <span>{p}</span>)}
  </div>
</section>

<style>
.providers{display:flex;flex-wrap:wrap;gap:12px}
span{border:1px solid var(--line-2);border-radius:var(--r-pill);padding:12px 24px;font-size:clamp(17px,2vw,22px);font-weight:560;letter-spacing:-.02em;background:var(--bg-2)}
</style>
